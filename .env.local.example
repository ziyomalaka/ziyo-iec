# Local dev (Go API :8080 + next.config rewrite /backend → 127.0.0.1:8080)
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Remote / ngrok (production yoki team tunnel)
# API_URL=https://your-ngrok-host.ngrok-free.dev
# NEXT_PUBLIC_API_URL=https://your-ngrok-host.ngrok-free.dev

# Frontend proxy path — odatda o'zgartirmaslik kerak
NEXT_PUBLIC_API_BASE=/backend

# Qayta tayyorlash student API (Swagger: /retraining/*). Demo rejim uchun false.
NEXT_PUBLIC_RETRAINING_API_ENABLED=true
